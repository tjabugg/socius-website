{
  "name": "socius_website",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@lottiefiles/lottie-interactivity": "^1.6.2",
    "@lottiefiles/lottie-player": "^2.0.2",
    "@lottiefiles/react-lottie-player": "^3.5.3",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "embla-carousel-autoplay": "^8.0.0-rc17",
    "embla-carousel-react": "^8.0.0-rc17",
    "framer-motion": "^12.23.24",
    "gsap": "^3.12.2",
    "lottie-react": "^2.4.0",
    "lottie-web": "^5.12.2",
    "react": "^18.2.0",
    "react-code-blocks": "^0.1.6",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-lottie": "^1.2.3",
    "react-router-dom": "^6.12.1",
    "react-scripts": "5.0.1",
    "react-syntax-highlighter": "^15.6.6",
    "styled-components": "^6.0.0-rc.3",
    "swiper": "^12.0.3",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "react-snap || echo 'WARNING: react-snap pre-rendering skipped (headless Chromium could not launch in this environment); deploying client-rendered SPA fallback.'",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "reactSnap": {
    "source": "build",
    "include": [
      "/",
      "/about",
      "/research",
      "/data",
      "/documentation",
      "/research/monitor-generate-verify",
      "/research/in-defence-of-post-hoc-explainability",
      "/research/system-1.5",
      "/research/before-you-think-monitor",
      "/data/sentibank",
      "/data/redditharbor",
      "/data/peltp"
    ],
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "react-snap": "^1.23.0"
  }
}
